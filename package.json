{
  "name": "getrest",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/desktop"
  ],
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "npm --workspace @getrest/desktop run dev",
    "build": "npm --workspace @getrest/desktop run build",
    "test": "npm --workspace @getrest/desktop run test",
    "typecheck": "npm --workspace @getrest/desktop run typecheck",
    "format": "prettier --write package.json apps/desktop",
    "format:check": "prettier --check package.json apps/desktop",
    "tauri": "npm --workspace @getrest/desktop run tauri --"
  }
}
